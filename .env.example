# ==============================================================================
# Forward Ledger Environment Configuration
# ==============================================================================

# 1. API-Football (RapidAPI or Direct API-Sports)
# Free Tier: 100 requests/day
# Sign up: https://rapidapi.com/api-sports/api/api-football
# Or direct: https://dashboard.api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here
# Provider type: "rapidapi" or "direct"
API_FOOTBALL_PROVIDER=rapidapi

# 2. The Odds API
# Free Tier: 500 requests/month
# Sign up: https://the-odds-api.com/#get-access
ODDS_API_KEY=your_the_odds_api_key_here

# 3. ntfy.sh (Push Alerts)
# Free pub/sub topic for monitoring and failover alerts
# Choose any unique topic string (subscribe via https://ntfy.sh or mobile app)
NTFY_TOPIC=forward-ledger-alerts-soccer

# 4. GitHub Automation Credentials (Optional for local, required for Vercel Cron to push LEDGER.md)
# Generate PAT: https://github.com/settings/tokens (Permissions: repo / Contents write)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=forward-ledger

# 5. Vercel Cron Secret (Optional, verifies calls come from Vercel's scheduler)
# Docs: https://vercel.com/docs/cron-jobs#securing-cron-jobs
CRON_SECRET=
